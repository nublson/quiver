# Local dev only
PORT=3001

# Web app base URL — used for CORS and trustedOrigins (update when custom domain is ready)
BASE_URL=http://localhost:3000

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Deployed API base URL
BETTER_AUTH_URL=http://localhost:3001

# GitHub OAuth App credentials
# Callback URL: http://localhost:3001/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase: Project Settings → Database → Connection string (URI, port 5432)
# For production via pooler: postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# One-time setup after filling DATABASE_URL:
#   cd apps/api
#   pnpm db:generate     ← generate Prisma client (no DB needed)
#   pnpm db:migrate      ← apply schema to Supabase
