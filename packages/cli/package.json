{
  "name": "usequiver",
  "description": "Keep your AI agent skills in sync across every device",
  "version": "0.2.7",
  "author": "Nubelson Fernandes",
  "bin": {
    "quiver": "./bin/run.js"
  },
  "bugs": "https://github.com/nublson/quiver/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "dotenv": "^16",
    "listr2": "^10.2.1",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://quiver.nublson.com",
  "keywords": [
    "quiver",
    "usequiver",
    "skills",
    "agent-skills",
    "skill-sync",
    "ai",
    "ai-agent",
    "claude-code",
    "cursor",
    "gemini-cli",
    "sync",
    "cli",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "quiver",
    "dirname": "quiver",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nublson/quiver.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "dev": "node ./bin/dev.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
